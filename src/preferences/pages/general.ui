<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0" />
  <requires lib="adw" version="1.0" />
  <template class="PrefsGeneral" parent="AdwPreferencesPage">
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">emblem-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Appearance</property>
        <property name="description" translatable="yes">Windows get the corners, border, outline, shadow and margin of libadwaita windows, in each state: normal, maximized, tiled and fullscreen. Change them in ~/.config/gtk-4.0/gtk.css and every window follows, live. libadwaita apps are left alone, since they already draw them.</property>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Tweaks</property>
        <child>
          <object class="AdwSwitchRow" id="suspendDuringInteraction">
            <property name="title" translatable="yes">Hide effects while moving or resizing</property>
            <property name="subtitle" translatable="yes">Hide borders, rounded corners and shadows during the operation, then fade them back together when it ends</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Debug</property>
        <child>
          <object class="AdwSwitchRow" id="enableDebugLogs">
            <property name="title" translatable="yes">Enable debug logs</property>
            <property name="subtitle" translatable="yes">Run journalctl -o cat -f /usr/bin/gnome-shell in your terminal to see the log</property>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
