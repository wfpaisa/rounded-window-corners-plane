#: src/preferences/pages/general.ui:31
#, fuzzy
msgid ""
"Run journalctl -o cat -f /usr/bin/gnome-shell in your terminal to see the log"
msgstr ""
"Voer <i>journalctl -o cat -f /usr/bin/gnome-shell</i> uit in een "
"terminalvenster om het logboek te bekijken"

