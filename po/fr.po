#: src/preferences/pages/general.ui:31
#, fuzzy
msgid ""
"Run journalctl -o cat -f /usr/bin/gnome-shell in your terminal to see the log"
msgstr ""
"Exécutez la command <i>journalctl -o cat -f /usr/bin/gnome-shell</i> dans un "
"terminal pour voir les journaux"

